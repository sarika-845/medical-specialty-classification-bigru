    "\n",
    "df_final = df[\n",
    "    df[\"medical_specialty\"].isin(TOP_CLASSES)\n",
    "].copy()\n",
    "\n",
    "df_final.reset_index(drop=True, inplace=True)\n",
    "\n",
    "print(\"Final classes:\")\n",
    "display(\n",
    "    df_final[\"medical_specialty\"].value_counts()\n",
    ")\n",
    "\n",
    "print(\"\\nTotal samples:\", len(df_final))"
   ]
