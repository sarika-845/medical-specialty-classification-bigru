    ")\n",
    "\n",
    "print(\"Label mapping:\")\n",
    "\n",
    "for index, class_name in enumerate(\n",
    "    label_encoder.classes_\n",
    "):\n",
    "    print(f\"{index} → {class_name}\")"
   ]
  },
