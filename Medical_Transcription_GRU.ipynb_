   "source": [
    "from tensorflow.keras import Input\n",
    "from tensorflow.keras.layers import (\n",
    "    Embedding,\n",
    "    Bidirectional,\n",
    "    GRU,\n",
    "    Dropout,\n",
    "    Dense\n",
    ")\n",
    "\n",
    "NUM_CLASSES = len(label_encoder.classes_)\n",
    "\n",
    "bigru_model = Sequential([\n",
    "    Input(\n",
    "        shape=(MAX_LEN,),\n",
    "        dtype=\"int32\"\n",
    "    ),\n",
    "\n",
    "    Embedding(\n",
    "        input_dim=MAX_WORDS,\n",
    "        output_dim=64,\n",
    "        mask_zero=True,\n",
    "        name=\"embedding\"\n",
    "    ),\n",
    "\n",
    "    Bidirectional(\n",
    "        GRU(\n",
    "            64,\n",
    "            dropout=0.25,\n",
    "            recurrent_dropout=0.0\n",
    "        ),\n",
    "        name=\"bidirectional_gru\"\n",
    "    ),\n",
    "\n",
    "    Dropout(\n",
    "        0.5,\n",
    "        name=\"dropout_1\"\n",
    "    ),\n",
    "\n",
    "    Dense(\n",
    "        32,\n",
    "        activation=\"relu\",\n",
    "        name=\"dense_1\"\n",
    "    ),\n",
    "\n",
    "    Dropout(\n",
    "        0.3,\n",
    "        name=\"dropout_2\"\n",
    "    ),\n",
    "\n",
    "    Dense(\n",
    "        NUM_CLASSES,\n",
    "        activation=\"softmax\",\n",
    "        name=\"output\"\n",
    "    )\n",
    "])\n",
    "\n",
    "bigru_model.compile(\n",
    "    optimizer=tf.keras.optimizers.Adam(\n",
    "        learning_rate=0.0005\n",
    "    ),\n",
    "    loss=\"sparse_categorical_crossentropy\",\n",
    "    metrics=[\"accuracy\"]\n",
    ")\n",
    "\n",
    "bigru_model.summary()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 49,
   "id": "49e53890-9bb7-4305-b281-b21f054f396a",
   "metadata": {},
   "outputs": [],
   "source": [
    "early_stopping = EarlyStopping(\n",
    "    monitor=\"val_loss\",\n",
    "    patience=4,\n",
    "    restore_best_weights=True,\n",
    "    verbose=1\n",
    ")\n",
    "\n",
    "reduce_lr = ReduceLROnPlateau(\n",
    "    monitor=\"val_loss\",\n",
    "    factor=0.5,\n",
    "    patience=2,\n",
    "    min_lr=1e-6,\n",
    "    verbose=1\n",
    ")"
   ]
  },
