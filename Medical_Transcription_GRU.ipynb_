    "def clean_medical_text(text):\n",
    "    text = str(text).lower()\n",
    "\n",
    "    # Remove HTML tags\n",
    "    text = re.sub(r\"<.*?>\", \" \", text)\n",
    "\n",
    "    # Keep letters, numbers and useful medical symbols\n",
    "    text = re.sub(\n",
    "        r\"[^a-z0-9\\s.,/%+-]\",\n",
    "        \" \",\n",
    "        text\n",
    "    )\n",
    "\n",
    "    # Normalize whitespace\n",
    "    text = re.sub(\n",
    "        r\"\\s+\",\n",
    "        \" \",\n",
    "        text\n",
    "    ).strip()\n",
    "\n",
    "    return text\n",
    "\n",
    "\n",
    "df_balanced[\"clean_transcription\"] = (\n",
    "    df_balanced[\"transcription\"]\n",
    "    .apply(clean_medical_text)\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "id": "edaa75f6-1023-4617-a4d2-a4786e96a4ba",
