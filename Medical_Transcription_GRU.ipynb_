   "source": [
    "# ---------------------------------------------------------\n",
    "# Create a balanced dataset using the 5 strongest classes\n",
    "# ---------------------------------------------------------\n",
    "\n",
    "TOP_CLASSES = (\n",
    "    df[\"medical_specialty\"]\n",
    "    .value_counts()\n",
    "    .head(5)\n",
    "    .index\n",
    ")\n",
    "\n",
    "print(\"Selected specialties:\")\n",
    "for i, specialty in enumerate(TOP_CLASSES, 1):\n",
    "    count = (df[\"medical_specialty\"] == specialty).sum()\n",
    "    print(f\"{i}. {specialty}: {count} samples\")\n",
    "\n",
    "\n",
    "# Number of samples to retain per class\n",
    "SAMPLES_PER_CLASS = 140\n",
    "\n",
    "balanced_parts = []\n",
    "\n",
    "for specialty in TOP_CLASSES:\n",
    "    class_data = df[\n",
    "        df[\"medical_specialty\"] == specialty\n",
    "    ].copy()\n",
    "\n",
    "    # Randomly select the same number from every class\n",
    "    class_sample = class_data.sample(\n",
    "        n=SAMPLES_PER_CLASS,\n",
    "        random_state=RANDOM_STATE\n",
    "    )\n",
    "\n",
    "    balanced_parts.append(class_sample)\n",
    "\n",
    "\n",
    "df_balanced = pd.concat(\n",
    "    balanced_parts,\n",
    "    ignore_index=True\n",
    ")\n",
    "\n",
    "# Shuffle the complete dataset\n",
    "df_balanced = df_balanced.sample(\n",
    "    frac=1,\n",
    "    random_state=RANDOM_STATE\n",
    ").reset_index(drop=True)\n",
    "\n",
    "\n",
    "print(\"\\nBalanced dataset shape:\", df_balanced.shape)\n",
    "\n",
    "print(\"\\nClass distribution:\")\n",
    "display(\n",
    "    df_balanced[\"medical_specialty\"].value_counts()\n",
    ")"
   ]
  },
