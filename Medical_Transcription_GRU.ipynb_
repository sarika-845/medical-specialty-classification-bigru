   ],
   "source": [
    "label_encoder = LabelEncoder()\n",
    "\n",
    "df_final[\"label\"] = label_encoder.fit_transform(\n",
    "    df_final[\"medical_specialty\"]\n",
    ")\n",
    "\n",
    "print(\"Label mapping:\")\n",
    "\n",
    "for i, name in enumerate(label_encoder.classes_):\n",
    "    print(f\"{i} → {name}\")"
   ]
  },
  {
