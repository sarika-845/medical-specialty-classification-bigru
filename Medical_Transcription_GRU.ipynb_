   "id": "96b13739-2f52-4fbb-af76-065b584b98c0",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Prediction: Radiology\n",
      "Confidence: 93.30%\n"
     ]
    }
   ],
   "source": [
    "with open(\n",
    "    \"artifacts/tokenizer.pkl\",\n",
    "    \"rb\"\n",
    ") as file:\n",
    "\n",
    "    loaded_tokenizer = pickle.load(file)\n",
    "\n",
    "\n",
    "with open(\n",
    "    \"artifacts/label_encoder.pkl\",\n",
    "    \"rb\"\n",
    ") as file:\n",
    "\n",
    "    loaded_encoder = pickle.load(file)\n",
    "\n",
    "\n",
    "sequence = loaded_tokenizer.texts_to_sequences(\n",
    "    [clean_medical_text(sample_text)]\n",
    ")\n",
    "\n",
    "padded = pad_sequences(\n",
    "    sequence,\n",
    "    maxlen=MAX_LEN,\n",
    "    padding=\"post\",\n",
    "    truncating=\"post\"\n",
    ")\n",
    "\n",
    "probabilities = loaded_model.predict(\n",
    "    padded,\n",
    "    verbose=0\n",
    ")[0]\n",
    "\n",
    "predicted_index = np.argmax(probabilities)\n",
    "\n",
    "predicted_class = loaded_encoder.inverse_transform(\n",
    "    [predicted_index]\n",
    ")[0]\n",
    "\n",
    "confidence = probabilities[predicted_index]\n",
    "\n",
    "print(\"Prediction:\", predicted_class)\n",
    "print(f\"Confidence: {confidence * 100:.2f}%\")"
   ]
  },
