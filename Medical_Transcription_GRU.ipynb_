  {
   "cell_type": "code",
   "execution_count": 66,
   "id": "17a0fa9e-68b5-4b05-bc86-398a161b61af",
   "metadata": {},
   "outputs": [],
   "source": [
    "def predict_specialty(text):\n",
    "    cleaned_text = clean_medical_text(text)\n",
    "\n",
    "    sequence = tokenizer.texts_to_sequences(\n",
    "        [cleaned_text]\n",
    "    )\n",
    "\n",
    "    padded_sequence = pad_sequences(\n",
    "        sequence,\n",
    "        maxlen=MAX_LEN,\n",
    "        padding=\"post\",\n",
    "        truncating=\"post\"\n",
    "    )\n",
    "\n",
    "    probabilities = bigru_model.predict(\n",
    "        padded_sequence,\n",
    "        verbose=0\n",
    "    )[0]\n",
    "\n",
    "    predicted_index = np.argmax(probabilities)\n",
    "\n",
    "    predicted_specialty = (\n",
    "        label_encoder.inverse_transform(\n",
    "            [predicted_index]\n",
    "        )[0]\n",
    "    )\n",
    "\n",
    "    confidence = probabilities[predicted_index]\n",
    "\n",
    "    return predicted_specialty, confidence"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 67,
   "id": "cbb19366-4e66-474a-a90c-e2b69b381652",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Predicted Specialty: Radiology\n",
      "Model Confidence: 93.30%\n"
     ]
    }
   ],
   "source": [
    "sample_text = \"\"\"\n",
    "The patient presents with chest pain and shortness of breath.\n",
    "History of hypertension. Physical examination performed.\n",
    "Chest imaging was obtained and findings were reviewed.\n",
    "\"\"\"\n",
    "\n",
    "prediction, confidence = predict_specialty(\n",
    "    sample_text\n",
    ")\n",
    "\n",
    "print(\"Predicted Specialty:\", prediction)\n",
    "print(\n",
    "    \"Model Confidence:\",\n",
    "    f\"{confidence * 100:.2f}%\"\n",
    ")"
   ]
  },
