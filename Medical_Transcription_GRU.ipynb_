     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Training shape: (560, 120)\n",
      "Testing shape : (140, 120)\n"
     ]
    }
   ],
   "source": [
    "MAX_WORDS = 5000\n",
    "MAX_LEN = 120\n",
    "\n",
    "tokenizer = Tokenizer(\n",
    "    num_words=MAX_WORDS,\n",
    "    oov_token=\"<OOV>\"\n",
    ")\n",
    "\n",
    "tokenizer.fit_on_texts(X_train)\n",
    "\n",
    "X_train_seq = tokenizer.texts_to_sequences(\n",
    "    X_train\n",
    ")\n",
    "\n",
    "X_test_seq = tokenizer.texts_to_sequences(\n",
    "    X_test\n",
    ")\n",
    "\n",
    "X_train_pad = pad_sequences(\n",
    "    X_train_seq,\n",
    "    maxlen=MAX_LEN,\n",
    "    padding=\"post\",\n",
    "    truncating=\"post\"\n",
    ")\n",
    "\n",
    "X_test_pad = pad_sequences(\n",
    "    X_test_seq,\n",
    "    maxlen=MAX_LEN,\n",
    "    padding=\"post\",\n",
    "    truncating=\"post\"\n",
    ")\n",
    "\n",
    "print(\"Training shape:\", X_train_pad.shape)\n",
    "print(\"Testing shape :\", X_test_pad.shape)"
   ]
  },
