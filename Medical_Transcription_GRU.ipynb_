    }
   ],
   "source": [
    "def clean_medical_text(text):\n",
    "    text = str(text).lower()\n",
    "\n",
    "    text = re.sub(r\"<.*?>\", \" \", text)\n",
    "\n",
    "    text = re.sub(\n",
    "        r\"[^a-z0-9\\s.,/%+-]\",\n",
    "        \" \",\n",
    "        text\n",
    "    )\n",
    "\n",
    "    text = re.sub(\n",
    "        r\"\\s+\",\n",
    "        \" \",\n",
    "        text\n",
    "    ).strip()\n",
    "\n",
    "    return text\n",
    "\n",
    "\n",
    "df_final[\"clean_transcription\"] = (\n",
    "    df_final[\"transcription\"]\n",
    "    .apply(clean_medical_text)\n",
    ")\n",
    "\n",
    "df_final = df_final[\n",
    "    df_final[\"clean_transcription\"].str.len() > 0\n",
    "].copy()\n",
    "\n",
    "df_final.reset_index(drop=True, inplace=True)\n",
    "\n",
    "print(\"Final dataset shape:\", df_final.shape)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 44,
   "id": "48c2e323-2718-43ba-8085-33adfb0b520b",
