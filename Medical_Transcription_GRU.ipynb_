   "source": [
    "# Predictions\n",
    "y_prob = gru_model.predict(\n",
    "    X_test_pad,\n",
    "    verbose=0\n",
    ")\n",
    "\n",
    "y_pred = np.argmax(\n",
    "    y_prob,\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "print(\n",
    "    classification_report(\n",
    "        y_test,\n",
    "        y_pred,\n",
    "        target_names=label_encoder.classes_,\n",
    "        digits=4\n",
    "    )\n",
    ")"
