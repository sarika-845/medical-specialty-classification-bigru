  {
   "cell_type": "code",
   "execution_count": 43,
   "id": "ae09d295-1b31-4934-9389-59f5bb2718d2",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Final dataset shape: (1681, 6)\n"
