   "source": [
    "from tensorflow.keras import Input\n",
    "\n",
    "NUM_CLASSES = len(label_encoder.classes_)\n",
    "\n",
    "gru_model = Sequential([\n",
    "    Input(\n",
    "        shape=(MAX_LEN,),\n",
    "        dtype=\"int32\"\n",
    "    ),\n",
    "\n",
    "    Embedding(\n",
    "        input_dim=MAX_WORDS,\n",
    "        output_dim=64,\n",
    "        mask_zero=True,\n",
    "        name=\"embedding\"\n",
    "    ),\n",
    "\n",
    "    GRU(\n",
    "        64,\n",
    "        dropout=0.2,\n",
    "        name=\"gru\"\n",
    "    ),\n",
    "\n",
    "    Dropout(\n",
    "        0.3,\n",
    "        name=\"dropout\"\n",
    "    ),\n",
    "\n",
    "    Dense(\n",
    "        32,\n",
    "        activation=\"relu\",\n",
    "        name=\"dense\"\n",
    "    ),\n",
    "\n",
    "    Dense(\n",
    "        NUM_CLASSES,\n",
    "        activation=\"softmax\",\n",
    "        name=\"output\"\n",
    "    )\n",
    "])\n",
    "\n",
    "gru_model.compile(\n",
    "    optimizer=tf.keras.optimizers.Adam(\n",
    "        learning_rate=0.001\n",
    "    ),\n",
    "    loss=\"sparse_categorical_crossentropy\",\n",
    "    metrics=[\"accuracy\"]\n",
    ")\n",
    "\n",
    "gru_model.summary()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 34,
   "id": "01484460-0af3-4346-b54d-d999162b671a",
   "metadata": {},
   "outputs": [],
   "source": [
    "early_stopping = EarlyStopping(\n",
    "    monitor=\"val_loss\",\n",
    "    patience=4,\n",
    "    restore_best_weights=True,\n",
    "    verbose=1\n",
    ")\n",
    "\n",
    "reduce_lr = ReduceLROnPlateau(\n",
    "    monitor=\"val_loss\",\n",
    "    factor=0.5,\n",
    "    patience=2,\n",
    "    min_lr=1e-6,\n",
    "    verbose=1\n",
    ")"
   ]
  },
