   "source": [
    "from tensorflow.keras import Input\n",
    "from tensorflow.keras.models import Sequential\n",
    "from tensorflow.keras.layers import Embedding, GRU, Dense, Dropout\n",
    "\n",
    "NUM_CLASSES = len(label_encoder.classes_)\n",
    "\n",
    "gru_model = Sequential([\n",
    "    Input(shape=(MAX_LEN,), dtype=\"int32\"),\n",
    "\n",
    "    Embedding(\n",
    "        input_dim=MAX_WORDS,\n",
    "        output_dim=64,\n",
    "        mask_zero=True,\n",
    "        name=\"word_embedding\"\n",
    "    ),\n",
    "\n",
    "    GRU(\n",
    "        64,\n",
    "        dropout=0.2,\n",
    "        name=\"gru_layer\"\n",
    "    ),\n",
    "\n",
    "    Dropout(\n",
    "        0.3,\n",
    "        name=\"dropout_1\"\n",
    "    ),\n",
    "\n",
    "    Dense(\n",
    "        32,\n",
    "        activation=\"relu\",\n",
    "        name=\"dense_1\"\n",
    "    ),\n",
    "\n",
    "    Dropout(\n",
    "        0.2,\n",
    "        name=\"dropout_2\"\n",
    "    ),\n",
    "\n",
    "    Dense(\n",
    "        NUM_CLASSES,\n",
    "        activation=\"softmax\",\n",
    "        name=\"output_layer\"\n",
    "    )\n",
    "])\n",
    "\n",
    "gru_model.compile(\n",
    "    optimizer=tf.keras.optimizers.Adam(\n",
    "        learning_rate=0.001\n",
    "    ),\n",
    "    loss=\"sparse_categorical_crossentropy\",\n",
    "    metrics=[\"accuracy\"]\n",
    ")\n",
    "\n",
    "gru_model.summary()"
   ]
  },
