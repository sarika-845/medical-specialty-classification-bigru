   "source": [
    "history_bigru = bigru_model.fit(\n",
    "    X_train_pad,\n",
    "    np.asarray(y_train, dtype=np.int32),\n",
    "\n",
    "    validation_split=0.15,\n",
    "\n",
    "    epochs=20,\n",
    "    batch_size=32,\n",
    "\n",
    "    class_weight=class_weights,\n",
    "\n",
    "    callbacks=[\n",
    "        early_stopping,\n",
    "        reduce_lr\n",
    "    ],\n",
    "\n",
    "    verbose=1\n",
    ")"
   ]
  },
